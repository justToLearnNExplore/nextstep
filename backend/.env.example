# Gemini API key (store in Secret Manager in production; mounted as env var on Cloud Run).
GOOGLE_API_KEY=
# Models (override per environment)
NEXTSTEP_OPERATOR_MODEL=gemini-3.8-flash
NEXTSTEP_REASONING_MODEL=gemini-3.8-flash
NEXTSTEP_FAST_MODEL=gemini-3.5-flash-lite
# "firestore" in production, "memory" for local dev/tests
NEXTSTEP_STORE=memory
GOOGLE_CLOUD_PROJECT=
# Firebase Auth: set to require a valid Firebase ID token on every request
NEXTSTEP_REQUIRE_AUTH=false
